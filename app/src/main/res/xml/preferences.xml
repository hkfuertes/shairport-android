<?xml version="1.0" encoding="utf-8"?>
<!-- Explicit orders keep the Advanced category in place when MainActivity re-adds it. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:order="0"
        android:title="@string/receiver_category">
        <SwitchPreference
            android:key="receiver_enabled"
            android:summary="@string/receiver_enabled_summary"
            android:title="@string/receiver_enabled_title" />
        <SwitchPreference
            android:key="airplay_2"
            android:summary="@string/airplay_2_summary"
            android:title="@string/airplay_2_title" />
        <SwitchPreference
            android:key="start_at_boot"
            android:summary="@string/start_at_boot_summary"
            android:title="@string/start_at_boot_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:order="2"
        android:title="@string/configuration_category">
        <EditTextPreference
            android:key="server_name"
            android:summary="@string/server_name_summary"
            android:title="@string/server_name_title" />
        <com.hkfuertes.shairport.ModelPreference
            android:entries="@array/model_entries"
            android:entryValues="@array/model_values"
            android:key="model"
            android:summary="%s"
            android:title="@string/model_title" />
        <Preference
            android:key="show_advanced"
            android:persistent="false"
            android:title="@string/show_advanced" />
    </PreferenceCategory>

    <!-- Hidden until "Show advanced settings" is tapped (MainActivity). -->
    <PreferenceCategory
        android:key="advanced"
        android:order="3"
        android:title="@string/advanced_category">
        <ListPreference
            android:entries="@array/playback_mode_entries"
            android:entryValues="@array/playback_mode_values"
            android:key="playback_mode"
            android:summary="@string/playback_mode_summary"
            android:title="@string/playback_mode_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:order="4"
        android:title="@string/permissions_category">
        <Preference
            android:key="root_access"
            android:persistent="false"
            android:summary="@string/root_access_checking"
            android:title="@string/root_access_title" />
    </PreferenceCategory>

    <!-- Live state of each part (MainActivity, from EngineStatus): read-only, shown disabled. -->
    <PreferenceCategory
        android:key="status"
        android:order="5"
        android:title="@string/status_category">
        <Preference
            android:key="status_shairport"
            android:enabled="false"
            android:persistent="false"
            android:selectable="false"
            android:title="@string/status_shairport_title" />
        <Preference
            android:key="status_nqptp"
            android:enabled="false"
            android:persistent="false"
            android:selectable="false"
            android:title="@string/status_nqptp_title" />
        <Preference
            android:key="status_mdns"
            android:enabled="false"
            android:persistent="false"
            android:selectable="false"
            android:title="@string/status_mdns_title" />
        <Preference
            android:key="status_playback"
            android:enabled="false"
            android:persistent="false"
            android:selectable="false"
            android:title="@string/status_playback_title" />
    </PreferenceCategory>
</PreferenceScreen>
