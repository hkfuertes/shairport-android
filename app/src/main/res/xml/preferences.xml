<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference
        android:key="root_access"
        android:persistent="false"
        android:summary="@string/root_access_checking"
        android:title="@string/root_access_title" />

    <PreferenceCategory android:title="@string/receiver_category">
        <SwitchPreference
            android:key="receiver_enabled"
            android:summary="@string/receiver_enabled_summary"
            android:title="@string/receiver_enabled_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/configuration_category">
        <EditTextPreference
            android:key="server_name"
            android:summary="@string/server_name_summary"
            android:title="@string/server_name_title" />
        <EditTextPreference
            android:key="model"
            android:summary="@string/model_summary"
            android:title="@string/model_title" />
        <EditTextPreference
            android:key="network_interface"
            android:summary="@string/interface_summary"
            android:title="@string/interface_title" />
        <EditTextPreference
            android:inputType="number"
            android:key="port"
            android:summary="@string/port_summary"
            android:title="@string/port_title" />
        <ListPreference
            android:entries="@array/audio_output_entries"
            android:entryValues="@array/audio_output_values"
            android:key="audio_output"
            android:summary="@string/audio_output_summary"
            android:title="@string/audio_output_title" />
        <ListPreference
            android:entries="@array/playback_mode_entries"
            android:entryValues="@array/playback_mode_values"
            android:key="playback_mode"
            android:summary="@string/playback_mode_summary"
            android:title="@string/playback_mode_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/fixed_category">
        <Preference
            android:selectable="false"
            android:summary="@string/fixed_engine_summary"
            android:title="@string/fixed_engine_title" />
    </PreferenceCategory>
</PreferenceScreen>
