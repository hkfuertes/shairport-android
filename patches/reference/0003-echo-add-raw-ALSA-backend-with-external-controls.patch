+fi
+AM_CONDITIONAL([USE_ECHO_ALSA], [test "x$with_echo_alsa" = "xyes"])
+
 # Look for jack flag
 AC_ARG_WITH(jack, [AS_HELP_STRING([--with-jack],[include a Jack Audio Connection Kit (jack) backend])])
 if test "x$with_jack" = "xyes" ; then
