diff --git a/audio_echo.c b/audio_echo.c
new file mode 100644
index 0000000..bb09cf5
--- /dev/null
+++ b/audio_echo.c
@@ -0,0 +1,291 @@
+/*
+ * Echo raw-ALSA audio backend. This file is part of Shairport Sync.
+ *
+ * It is intentionally fixed to the Echo hardware contract exposed by
+ * libecho_alsa: 48 kHz, stereo, signed 16-bit little-endian PCM.
+ */
+
+#include "config.h"
+
+#include "audio.h"
+#include "common.h"
+
+#include <echo_alsa.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define ECHO_PERIOD_FRAMES 1024U
+#define ECHO_CHANNELS 2U
+#define ECHO_ENCODED_FORMAT                                                                    \
+  (CHANNELS_TO_ENCODED_FORMAT(ECHO_CHANNELS) | RATE_TO_ENCODED_FORMAT(48000) |                \
+   FORMAT_TO_ENCODED_FORMAT(SPS_FORMAT_S16_LE))
+
+static pthread_mutex_t echo_mutex = PTHREAD_MUTEX_INITIALIZER;
+static echo_alsa_t *echo_device = NULL;
+static int16_t echo_period[ECHO_PERIOD_FRAMES * ECHO_CHANNELS];
+static uint32_t echo_pending_frames = 0;
+static int echo_discontinuity = 1;
+
+static volume_range_t echo_volume_range = {.minimum_volume_dB = -6350, .maximum_volume_dB = 0};
+static output_parameters_t echo_parameters = {.volume_range = &echo_volume_range};
+
+static int close_device(void) {
+  int rc = 0;
+  echo_pending_frames = 0;
+  if (echo_device != NULL) {
+    rc = echo_alsa_close(echo_device);
+    echo_device = NULL;
+  }
+  return rc;
+}
+
+static int open_device(void) {
+  echo_alsa_t *device = NULL;
+  echo_alsa_config_t configuration = {0};
+  int rc = echo_alsa_open(&device);
+  if (rc != 0)
+    return rc;
+
+  rc = echo_alsa_get_config(device, &configuration);
+  if ((rc != 0) || (configuration.sample_rate != 48000) || (configuration.channels != 2) ||
+      (configuration.period_frames != 1024) || (configuration.periods != 4)) {
+    if (rc == 0)
+      rc = -EINVAL;
+    echo_alsa_close(device);
+    return rc;
+  }
+
+  // Volume, mute and speaker amplification are owned by echo-volume-control.
+  // This handle retains only PCM, routing and XRUN GPIO recovery.
+  rc = echo_alsa_set_external_controls(device, 1);
+  if (rc != 0) {
+    echo_alsa_close(device);
+    return rc;
+  }
+
+  rc = echo_alsa_start(device);
+  if (rc != 0) {
+    echo_alsa_close(device);
+    return rc;
+  }
+
+  echo_device = device;
+  echo_pending_frames = 0;
+  echo_discontinuity = 1;
+  debug(2, "echo: opened periodised Echo ALSA output");
+  return 0;
+}
+
+static void help(void) {
+  printf("\nEcho raw ALSA backend: fixed 48 kHz, stereo, S16_LE output.\n");
+}
+
+static int init(int argc, char **argv) {
+  (void)argc;
+  (void)argv;
+  debug(2, "echo: initialised raw Echo ALSA backend");
+  return 0;
+}
+
+static void deinit(void) {
+  pthread_mutex_lock(&echo_mutex);
+  int rc = close_device();
+  if (rc != 0)
+    debug(1, "echo: close failed: %d", rc);
+  pthread_mutex_unlock(&echo_mutex);
+}
+
+static int prepare(void) { return 0; }
+
+static int32_t get_configuration(unsigned int channels, unsigned int rate, unsigned int format) {
+  (void)channels;
+  (void)rate;
+  (void)format;
+  return ECHO_ENCODED_FORMAT;
+}
+
+static int configure(int32_t requested_encoded_format, char **channel_map) {
+  if (channel_map != NULL)
+    *channel_map = NULL;
+  if (requested_encoded_format != ECHO_ENCODED_FORMAT) {
+    debug(1, "echo: unsupported output configuration %s",
+          short_format_description(requested_encoded_format));
+    return -EINVAL;
+  }
+  return 0;
+}
+
+static void start(int sample_rate, int sample_format) {
+  (void)sample_rate;
+  (void)sample_format;
+}
+
+static int write_pending_period(void) {
+  uint32_t frames_written = 0;
+  int rc = echo_alsa_write_s16le(echo_device, echo_period, ECHO_PERIOD_FRAMES, &frames_written);
+  if (rc == -EPIPE) {
+    echo_discontinuity = 1;
+    debug(1, "echo: underrun; recovering and retrying the same period");
+    rc = echo_alsa_flush(echo_device);
+    if (rc == 0)
+      rc = echo_alsa_start(echo_device);
+    if (rc == 0) {
+      frames_written = 0;
+      rc = echo_alsa_write_s16le(echo_device, echo_period, ECHO_PERIOD_FRAMES, &frames_written);
+    }
+  }
+  if ((rc == 0) && (frames_written != ECHO_PERIOD_FRAMES))
+    rc = -EIO;
+  if (rc != 0) {
+    echo_discontinuity = 1;
+    debug(1, "echo: period write failed: %d after %u of %u frames", rc, frames_written,
+          ECHO_PERIOD_FRAMES);
+  }
+  return rc;
+}
+
+static int play(void *buf, int samples, int sample_type, uint32_t timestamp, uint64_t playtime) {
+  (void)sample_type;
+  (void)timestamp;
+  (void)playtime;
+  if (samples < 0 || ((samples > 0) && (buf == NULL)))
+    return -EINVAL;
+  if (samples == 0)
+    return 0;
+
+  const int16_t *input = buf;
+  uint32_t remaining = (uint32_t)samples;
+  pthread_mutex_lock(&echo_mutex);
+  int rc = 0;
+  if (echo_device == NULL)
+    rc = open_device();
+
+  while ((rc == 0) && ((remaining != 0) || (echo_pending_frames == ECHO_PERIOD_FRAMES))) {
+    if (echo_pending_frames == ECHO_PERIOD_FRAMES) {
+      rc = write_pending_period();
+      if (rc == 0)
+        echo_pending_frames = 0;
+      continue;
+    }
+
+    uint32_t copied_frames = ECHO_PERIOD_FRAMES - echo_pending_frames;
+    if (copied_frames > remaining)
+      copied_frames = remaining;
+    memcpy(&echo_period[echo_pending_frames * ECHO_CHANNELS], input,
+           copied_frames * ECHO_CHANNELS * sizeof(*input));
+    echo_pending_frames += copied_frames;
+    input += copied_frames * ECHO_CHANNELS;
+    remaining -= copied_frames;
+  }
+  pthread_mutex_unlock(&echo_mutex);
+  return rc;
+}
+
+static void stop(void) {
+  pthread_mutex_lock(&echo_mutex);
+  int rc = close_device();
+  if (rc != 0)
+    debug(1, "echo: stop failed: %d", rc);
+  pthread_mutex_unlock(&echo_mutex);
+}
+
+static void flush(void) {
+  pthread_mutex_lock(&echo_mutex);
+  echo_pending_frames = 0;
+  if (echo_device != NULL) {
+    int rc = echo_alsa_flush(echo_device);
+    echo_discontinuity = 1;
+    if (rc != 0)
+      debug(1, "echo: flush failed: %d", rc);
+  }
+  pthread_mutex_unlock(&echo_mutex);
+}
+
+static int delay(long *the_delay) {
+  int32_t frames = 0;
+  uint32_t pending_frames = 0;
+  int rc = -ENODEV;
+  if (the_delay != NULL)
+    *the_delay = 0;
+
+  pthread_mutex_lock(&echo_mutex);
+  pending_frames = echo_pending_frames;
+  if (echo_device != NULL)
+    rc = echo_alsa_delay_frames(echo_device, &frames);
+  pthread_mutex_unlock(&echo_mutex);
+
+  if ((rc == 0) && (frames >= 0) && (the_delay != NULL))
+    *the_delay = (long)frames + pending_frames;
+  else if ((rc == 0) && (frames < 0))
+    rc = -EIO;
+  return rc;
+}
+
+static int stats(uint64_t *raw_measurement_time, uint64_t *corrected_measurement_time,
+                 uint64_t *the_delay, uint64_t *frames_sent_to_dac) {
+  echo_alsa_stats_t measurements = {0};
+  int rc = -ENODEV;
+  if (raw_measurement_time != NULL)
+    *raw_measurement_time = 0;
+  if (corrected_measurement_time != NULL)
+    *corrected_measurement_time = 0;
+  if (the_delay != NULL)
+    *the_delay = 0;
+  if (frames_sent_to_dac != NULL)
+    *frames_sent_to_dac = 0;
+
+  pthread_mutex_lock(&echo_mutex);
+  if (echo_device != NULL) {
+    rc = echo_alsa_stats(echo_device, &measurements);
+    if (raw_measurement_time != NULL)
+      *raw_measurement_time = get_absolute_time_in_ns();
+    if (corrected_measurement_time != NULL)
+      *corrected_measurement_time = get_monotonic_time_in_ns();
+    if ((the_delay != NULL) && (measurements.delay_frames >= 0))
+      *the_delay = (uint64_t)measurements.delay_frames + echo_pending_frames;
+    if (frames_sent_to_dac != NULL)
+      *frames_sent_to_dac = measurements.frames_sent_to_dac + echo_pending_frames;
+    if (rc != 0)
+      echo_discontinuity = 1;
+    else if (echo_discontinuity) {
+      rc = 1;
+      echo_discontinuity = 0;
+    }
+  }
+  pthread_mutex_unlock(&echo_mutex);
+  return rc;
+}
+
+static void volume(double vol) {
+  // Metadata carries this to echo-volume-control, the sole mixer owner.
+  debug(2, "echo: handing volume %.2f dB to echo-volume-control", vol / 100.0);
+}
+
+static int mute(int do_mute) {
+  // The pvol metadata record carries the same -144 dB sentinel to the controller.
+  debug(2, "echo: handing mute %d to echo-volume-control", do_mute != 0);
+  return 1;
+}
+
+static output_parameters_t *parameters(void) { return &echo_parameters; }
+
+audio_output audio_echo = {.name = "echo",
+                           .help = &help,
+                           .init = &init,
+                           .deinit = &deinit,
+                           .prepare = &prepare,
+                           .get_configuration = &get_configuration,
+                           .configure = &configure,
+                           .start = &start,
+                           .stop = &stop,
+                           .is_running = NULL,
+                           .flush = &flush,
+                           .delay = &delay,
+                           .play = &play,
+                           .stats = &stats,
+                           .mute = &mute,
+                           .volume = &volume,
+                           .parameters = &parameters};
