From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Miguel Fuertes <hkfuertes@users.noreply.github.com>
Date: Fri, 25 Sep 2026 09:16:39 +0200
Subject: [PATCH 1/3] tinysvcmdns: register AirPlay 2 service with full TXT
 records

The TinySVCmDNS backend only registered _raop. Register _airplay too, with the
generated primary/secondary TXT records, and accept 255-byte TXT entries.

Upstream: candidate (generic fix; not needed when using avahi)
Signed-off-by: Miguel Fuertes <hkfuertes@users.noreply.github.com>
---
 mdns_tinysvcmdns.c | 53 ++++++++++++++++++----------------------------
 tinysvcmdns.c      | 20 +++++++++++++++--
 2 files changed, 39 insertions(+), 34 deletions(-)

diff --git a/mdns_tinysvcmdns.c b/mdns_tinysvcmdns.c
index c7b5646..f460fcb 100644
--- a/mdns_tinysvcmdns.c
+++ b/mdns_tinysvcmdns.c
@@ -39,9 +39,21 @@
 
 static struct mdnsd *svr = NULL;
 
-static int mdns_tinysvcmdns_register(char *ap1name, __attribute__((unused)) char *ap2name, int port,
-                                     __attribute__((unused)) char **txt_records,
-                                     __attribute__((unused)) char **secondary_txt_records) {
+static void mdns_tinysvcmdns_register_service(const char *name, const char *regtype, int port,
+                                              char **txt_records) {
+  char *extendedregtype = malloc(strlen(regtype) + strlen(".local") + 1);
+  if (extendedregtype == NULL)
+    die("tinysvcmdns: could not allocate memory to request a Zeroconf service");
+  strcpy(extendedregtype, regtype);
+  strcat(extendedregtype, ".local");
+  struct mdns_service *svc = mdnsd_register_svc(svr, name, extendedregtype, port, NULL,
+                                                (const char **)txt_records);
+  mdns_service_destroy(svc);
+  free(extendedregtype);
+}
+
+static int mdns_tinysvcmdns_register(char *ap1name, char *ap2name, int port,
+                                     char **txt_records, char **secondary_txt_records) {
   struct ifaddrs *ifalist;
   struct ifaddrs *ifa;
 
@@ -120,39 +132,16 @@ static int mdns_tinysvcmdns_register(char *ap1name, __attribute__((unused)) char
     }
   }
 
-  freeifaddrs(ifa);
-
-  char *txtwithoutmetadata[] = {MDNS_RECORD_WITHOUT_METADATA, NULL};
-#ifdef CONFIG_METADATA
-  char *txtwithmetadata[] = {MDNS_RECORD_WITH_METADATA, NULL};
-#endif
-  char **txt;
-
-#ifdef CONFIG_METADATA
-  if (config.metadata_enabled)
-    txt = txtwithmetadata;
-  else
-#endif
-
-    txt = txtwithoutmetadata;
+  freeifaddrs(ifalist);
 
   if (config.regtype == NULL)
     die("tinysvcmdns: regtype is null");
+  mdns_tinysvcmdns_register_service(ap1name, config.regtype, port, txt_records);
+#ifdef CONFIG_AIRPLAY_2
+  if (ap2name != NULL && config.regtype2 != NULL && secondary_txt_records != NULL)
+    mdns_tinysvcmdns_register_service(ap2name, config.regtype2, port, secondary_txt_records);
+#endif
 
-  char *extendedregtype = malloc(strlen(config.regtype) + strlen(".local") + 1);
-
-  if (extendedregtype == NULL)
-    die("tinysvcmdns: could not allocated memory to request a Zeroconf service");
-
-  strcpy(extendedregtype, config.regtype);
-  strcat(extendedregtype, ".local");
-
-  struct mdns_service *svc =
-      mdnsd_register_svc(svr, ap1name, extendedregtype, port, NULL,
-                         (const char **)txt); // TTL should be 75 minutes, i.e. 4500 seconds
-  mdns_service_destroy(svc);
-
-  free(extendedregtype);
 
   return 0;
 }
diff --git a/tinysvcmdns.c b/tinysvcmdns.c
index 210c91d..7674c2f 100644
--- a/tinysvcmdns.c
+++ b/tinysvcmdns.c
@@ -185,6 +185,22 @@ static size_t label_len(uint8_t *pkt_buf, size_t pkt_len, size_t off) {
   return len;
 }
 
+// creates one DNS TXT character-string (maximum 255 bytes).
+uint8_t *create_txt_label(const char *txt) {
+  if (txt == NULL)
+    return NULL;
+  size_t len = strlen(txt);
+  if (len > 255)
+    die("mDNS TXT record is longer than 255 bytes");
+  uint8_t *s = malloc(len + 2);
+  if (s == NULL)
+    die("can not allocate memory for mDNS TXT record");
+  s[0] = (uint8_t)len;
+  memcpy(s + 1, txt, len);
+  s[len + 1] = '\0';
+  return s;
+}
+
 // creates a label
 // free() after use
 uint8_t *create_label(const char *txt) {
@@ -541,7 +557,7 @@ void rr_add_txt(struct rr_entry *rr_txt, const char *txt) {
 
   // is current data filled?
   if (txt_rec->txt == NULL) {
-    txt_rec->txt = create_label(txt);
+    txt_rec->txt = create_txt_label(txt);
     return;
   }
 
@@ -553,7 +569,7 @@ void rr_add_txt(struct rr_entry *rr_txt, const char *txt) {
   txt_rec->next = malloc(sizeof(struct rr_data_txt));
 
   txt_rec = txt_rec->next;
-  txt_rec->txt = create_label(txt);
+  txt_rec->txt = create_txt_label(txt);
   txt_rec->next = NULL;
 }
 
