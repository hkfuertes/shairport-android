+#ifdef __ANDROID__
+// Bionic has no pthread cancellation. Do not let a cooperative cancellation
+// request wait indefinitely for a silent AP2 socket to receive another packet.
+static int android_wait_for_ap2_packet(int socket_fd) {
+  struct pollfd poll_fd = {.fd = socket_fd, .events = POLLIN, .revents = 0};
+  // EINTR is the SIGUSR1 cancel wake-up: test it now instead of polling again.
+  int rc = poll(&poll_fd, 1, 250);
+  pthread_testcancel();
+  return rc > 0;
+}
+#endif
