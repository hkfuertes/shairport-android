--- a/common.c
+++ b/common.c
@@ -2268,7 +2268,9 @@ char *debug_malloc_hex_cstring(void *packet, size_t nread) {
 
 int get_device_id(uint8_t *id, int int_length) {
 
-  uint64_t wait_time = 10000000000L; // wait up to this (ns) long to get a MAC address
+  // Android: apps can't read MAC addresses, so don't wait for one (the app passes
+  // general.airplay_device_id instead).
+  uint64_t wait_time = 0;
 
   int response = -1;
   struct ifaddrs *ifaddr = NULL;
@@ -2330,7 +2332,7 @@ int get_device_id(uint8_t *id, int int_length) {
     time_to_wait = wait_until - get_absolute_time_in_ns();
   } while ((response != 0) && (time_to_wait > 0));
   if (response != 0)
-    warn("Can't create a device ID -- no valid MAC address can be found.");
+    debug(1, "Can't create a device ID -- no valid MAC address can be found.");
   return response;
 }
 
