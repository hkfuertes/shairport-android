diff --git a/android-shm-compat.c b/android-shm-compat.c
new file mode 100644
index 0000000..c9add4f
--- /dev/null
+++ b/android-shm-compat.c
@@ -0,0 +1,38 @@
+#include "android-shm-compat.h"
+
+#ifdef __ANDROID__
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define NQPTP_SHM_PATH_MAX 256
+
+static int shm_path(char path[NQPTP_SHM_PATH_MAX], const char *name) {
+  if (name == NULL || name[0] != '/' || name[1] == '\0' || strchr(name + 1, '/') != NULL) {
+    errno = EINVAL;
+    return -1;
+  }
+  const char *directory = getenv("NQPTP_SHM_DIRECTORY");
+  if (directory == NULL || directory[0] != '/')
+    directory = "/dev/shm";
+  int written = snprintf(path, NQPTP_SHM_PATH_MAX, "%s%s", directory, name);
+  if (written < 0 || written >= NQPTP_SHM_PATH_MAX) {
+    errno = ENAMETOOLONG;
+    return -1;
+  }
+  return 0;
+}
+
+int shm_open(const char *name, int oflag, mode_t mode) {
+  char path[NQPTP_SHM_PATH_MAX];
+  return shm_path(path, name) == 0 ? open(path, oflag, mode) : -1;
+}
+
+int shm_unlink(const char *name) {
+  char path[NQPTP_SHM_PATH_MAX];
+  return shm_path(path, name) == 0 ? unlink(path) : -1;
+}
+#endif
